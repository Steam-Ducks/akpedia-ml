# Copie para .env e ajuste conforme necessário.
# Valores em branco caem no default da aplicação (veja src/app/config.py).

# --- Aplicação ---
APP_PORT=8000

# Maior upload aceito por POST /api/v1/documents/process, em bytes (default: 25 MiB).
MAX_UPLOAD_BYTES=

# --- Análise (POST /api/v1/documents/analyze) ---
# Centróides gerados por scripts/build_centroids.py. Sem o arquivo, category vem null.
CENTROIDS_PATH=
# Máximo de chunks embedados para classificar um documento (default: 20).
ANALYSIS_MAX_CHUNKS=
# Temperatura do softmax da categoria (default: 0.05; 1.0 = softmax literal).
CATEGORY_TEMPERATURE=

# --- Embeddings ---
# Qualquer modelo do sentence-transformers. Trocar muda model.dimensions na resposta,
# o que exige reindexar no akpedia-server (default: intfloat/multilingual-e5-small).
EMBEDDING_MODEL=

# --- Worker de indexação (python -m app.worker / docker compose --profile worker up) ---
# Redis com o stream de documentos aprovados. Sobe no compose do akpedia-server; no
# docker-compose o default é redis://akpedia-redis:6379/0 (rede akpedia-net), fora do
# Docker é redis://localhost:6379/0.
REDIS_URL=
# Stream e consumer group (defaults: documents:processing e ml-workers).
DOCUMENTS_STREAM=
WORKER_GROUP=
# Nome desta réplica no group (default: nome do host; no docker-compose: akpedia-ml-worker).
# Precisa ser estável entre reinícios para o worker retomar as próprias mensagens pendentes.
WORKER_CONSUMER=
# akpedia-server, de onde o worker baixa o arquivo e para onde manda o resultado.
SERVER_BASE_URL=
# Segredo enviado no header X-Internal-Token. Obrigatório: sem ele o worker não sobe.
INTERNAL_API_TOKEN=
# Timeout de cada chamada ao server, em segundos (default: 30).
SERVER_TIMEOUT_SECONDS=
